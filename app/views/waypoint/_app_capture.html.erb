<%# Panel: capture. The product. Talk or type, confirm, and only then believe it. %>
<%# Locals: none. %>
<div data-waypoint-app-target="panel" data-panel-name="capture"
     class="flex min-h-0 flex-1 flex-col">

  <div data-waypoint-app-target="thread"
       class="flex min-h-0 flex-1 flex-col gap-2.5 overflow-y-auto px-4 py-4">

    <div class="max-w-[85%] self-end rounded-2xl rounded-br-sm bg-zinc-100 px-3 py-2 text-[13px] text-zinc-900">
      2018 civic oil change 84k 95 dollars
    </div>

    <div class="self-stretch rounded-xl border border-emerald-600/60 bg-emerald-950/30 p-3">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400">Parsed</span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wide text-zinc-400">Vehicle</div>
          <div class="text-[13px] font-semibold text-zinc-100">2018 Honda Civic</div>
        </div>
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wide text-zinc-400">Service</div>
          <div class="text-[13px] font-semibold text-zinc-100">Oil change</div>
        </div>
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wide text-zinc-400">Mileage</div>
          <div class="text-[13px] font-semibold text-zinc-100">84,000</div>
        </div>
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wide text-zinc-400">Collected</div>
          <div class="text-[13px] font-semibold text-zinc-100">$95</div>
        </div>
      </div>
      <p class="mt-3 border-t border-emerald-800/60 pt-2 text-[12px] text-zinc-400">
        Two Civics in your records. Which one did you do?
      </p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-action="waypoint-app#commit"
                class="flex-1 rounded-lg bg-emerald-600 px-3 py-2 text-[13px] font-bold text-white transition-colors hover:bg-emerald-500">
          Log it
        </button>
        <button type="button" data-action="waypoint-app#reject"
                class="rounded-lg border border-zinc-700 px-3 py-2 text-[13px] font-bold text-zinc-300 transition-colors hover:border-zinc-500">
          Not right
        </button>
      </div>
    </div>

    <div class="max-w-[85%] self-start rounded-2xl rounded-bl-sm bg-zinc-800 px-3 py-2 text-[13px] text-zinc-100">
      Logged. Was the spec right for this one? One tap and I remember it.
    </div>

    <p class="text-[11px] text-zinc-600">
      Jobs today: <span data-waypoint-app-target="jobCount" data-count="3">3</span>
    </p>
  </div>

  <div class="shrink-0 border-t border-zinc-800 px-4 py-3">
    <div class="flex items-center gap-2">
      <input data-waypoint-app-target="inputField"
             data-action="keydown->waypoint-app#submitOnEnter"
             placeholder="Type, or tap the mic..."
             autocomplete="off"
             class="min-w-0 flex-1 rounded-full border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-[13px] text-zinc-100 outline-none placeholder:text-zinc-500 focus:border-emerald-600">

      <button type="button" data-waypoint-app-target="micButton" data-action="waypoint-app#toggleMic"
              aria-label="Talk"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-800 text-zinc-300 transition-colors">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <rect x="9" y="2" width="6" height="12" rx="3"></rect>
          <path d="M5 11a7 7 0 0 0 14 0"></path>
          <line x1="12" y1="18" x2="12" y2="22"></line>
        </svg>
      </button>

      <button type="button" data-action="waypoint-app#send" aria-label="Send"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white transition-colors hover:bg-emerald-500">
        &uarr;
      </button>
    </div>
    <p class="mt-2 text-[10px] text-zinc-600">Hands free &middot; no model call on the common shape</p>
  </div>
</div>
