<%# Panel: specs. The lookup lives inside the conversation, not in another tool. %>
<%# Locals: none. Data is the waypoint-app controller's specs value. %>
<div data-waypoint-app-target="panel" data-panel-name="specs"
     class="hidden min-h-0 flex-1 flex-col overflow-y-auto px-4 py-4">

  <input data-waypoint-app-target="specInput"
         data-action="input->waypoint-app#lookup"
         placeholder="Transmission code, or year make model..."
         autocomplete="off"
         class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2.5 text-[13px] text-zinc-100 outline-none placeholder:text-zinc-500 focus:border-emerald-600">

  <p class="mt-2 text-[11px] text-zinc-500">
    Try <span class="font-semibold text-zinc-300">RE0F10A</span> for the answer, or
    <span class="font-semibold text-zinc-300">2019 nissan rogue</span> for the honest empty.
  </p>

  <div data-waypoint-app-target="specResults" class="mt-3"></div>

  <p class="mt-auto pt-4 text-[10px] text-zinc-600">
    Confidence is never hidden, and it asks when it does not know.
  </p>
</div>
