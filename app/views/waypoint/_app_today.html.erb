<%# Panel: today. The jobs logged today, read from waypoint_jobs. %>
<%# Locals: none. Uses @jobs_today. Travel time is NOT tracked yet - so it is not shown. %>
<% fmt = ->(n) { number_to_currency(n || 0) } %>
<% today_total = @jobs_today.sum { |j| j.total.to_f } %>
<div data-waypoint-app-target="panel" data-panel-name="today"
     class="hidden min-h-0 flex-1 flex-col overflow-y-auto px-4 py-4">

  <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-3">
    <div class="flex items-baseline justify-between">
      <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500">Quoted today</span>
      <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500">
        <span data-waypoint-app-target="todayCount"><%= @jobs_today.size %></span> job(s)
      </span>
    </div>
    <div class="mt-0.5 text-3xl font-bold tracking-tight"><%= fmt.call(today_total) %></div>
    <p class="mt-1 text-[11px] text-zinc-500">
      Travel time is not tracked yet, so it is not shown. An invented number is worse than a blank one.
    </p>
  </div>

  <div class="mt-3 rounded-xl border border-zinc-800 bg-zinc-900/60 p-3">
    <% if @jobs_today.any? %>
      <% @jobs_today.each do |job| %>
        <div class="flex gap-3 border-b border-zinc-800 py-2.5 last:border-b-0">
          <div class="w-11 shrink-0 pt-0.5 text-[12px] font-bold text-zinc-400">
            <%= job.created_at.strftime("%-I:%M") %>
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-[13px] font-semibold text-zinc-100">
              <%= job.vehicle_label.presence || "unknown vehicle" %>
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-2 text-[11px] text-zinc-400">
              <span><%= job.service %></span>
              <% if job.mileage.present? %>
                <span><%= number_with_delimiter(job.mileage) %> mi</span>
              <% end %>
              <span class="font-semibold text-zinc-300"><%= fmt.call(job.total) %></span>
              <span class="rounded-full bg-zinc-800 px-2 py-0.5 text-[10px] font-bold text-zinc-400">
                <%= job.status %>
              </span>
            </div>
            <% if (job.gaps || []).any? %>
              <div class="mt-1 text-[11px] leading-snug text-amber-400">
                <%= job.gaps.join(" &middot; ").html_safe %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="py-2 text-[12px] text-zinc-500">
        No jobs logged today yet. The Capture panel writes here.
      </p>
    <% end %>
  </div>

  <div class="mt-3 rounded-xl border border-zinc-800 bg-zinc-900/60 p-3">
    <div class="text-[10px] font-bold uppercase tracking-widest text-zinc-500">Next up</div>
    <div class="mt-1 text-[14px] font-semibold text-zinc-100">Check a spec before the car arrives</div>
    <p class="mt-1 text-[12px] text-zinc-400">
      Waypoint has NS-3 for eight Rogue codes. Confirmed, not guessed.
    </p>
    <button type="button" data-action="waypoint-app#showTab" data-panel="specs"
            class="mt-2.5 rounded-lg bg-emerald-600 px-3 py-2 text-[13px] font-bold text-white transition-colors hover:bg-emerald-500">
      Check the spec
    </button>
  </div>
</div>
