<%# Frame response for /waypoint/labs-lounge — header + content %>
<%= turbo_frame_tag "waypoint_chat", class: "flex-1 flex flex-col min-h-0" do %>
  <%= render "waypoint/channel_header", channel_name: "labs-lounge", channel_topic: "Lab chatter, weekly reports, status updates" %>
  <div class="flex-1 overflow-y-auto px-2 md:px-4 py-4">
    <%= render "waypoint/labs_lounge" %>
  </div>
<% end %>