<%# Genre list. Rendered by ZukeController#genres.
    #
    # @grouped_genres holds the top songs per genre (raw records, used for the
    # heading count); @genre_songs holds the same songs already serialized through
    # SongPresenter, keyed by genre.
    #
    # This partial used to inline its own copy of the smart-image markup and pass
    # song.audio_file as the URL value. That interpolates an Active Storage
    # attachment object — `<%= song.audio_file %>` renders
    # "#<ActiveStorage::Attached::One:0x...>" — so every play button in this tab
    # was broken. It now renders the shared component, which takes presenter keys.
    #
    # The count comes from @grouped_genres (every song with this genre) while only
    # playable songs are serialized, so the heading can legitimately say a genre
    # has tracks and then render none of them. %>
<%= turbo_frame_tag "music-frame" do %>
  <div id="music_frame" class="w-full">
    <% @grouped_genres.each do |genre, songs| %>
      <% serialized = @genre_songs[genre] || [] %>
      <div class="genre-group mb-8">
        <!-- Genre heading -->
        <div class="genre-heading sticky top-0 bg-zinc-900 text-white py-2 px-4 text-xl font-bold z-10">
          <%= genre.name %>
          <span class="text-sm font-normal text-gray-400"><%= songs.size %> tracks</span>
        </div>

        <% if serialized.any? %>
          <div class="albums-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 px-4 py-2">
            <% serialized.each do |song| %>
              <div class="album-card group">
                <%= render partial: "zuke/components/smart-image", locals: { controller_name: "smart-image", song: song } %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-4 py-2 text-sm text-gray-400">No playable tracks yet.</div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
