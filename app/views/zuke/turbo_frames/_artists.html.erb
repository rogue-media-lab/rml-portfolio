<%# Artist list, grouped by first letter. Rendered by ZukeController#artists.
    #
    # @grouped_artists holds raw Artist records (for names and artwork);
    # @artist_songs holds each artist's songs already serialized through
    # SongPresenter, keyed by artist id.
    #
    # Two bugs lived here. The card interpolated `first_song.audio_file` into a
    # data attribute, which renders an Active Storage object rather than a URL, so
    # the play button was broken; and it called `first_song.id` without a nil
    # check, so an artist with no songs raised NoMethodError. Both are gone: songs
    # render through the shared smart-image component, and an artist with nothing
    # playable still renders without a play affordance. %>
<%= turbo_frame_tag "music-frame" do %>
  <div id="music_frame" class="w-full">
    <% @grouped_artists.each do |letter, artists| %>
      <div class="letter-group mb-8">
        <!-- Letter heading -->
        <div class="letter-heading sticky top-0 bg-zinc-900 text-white py-2 px-4 text-xl font-bold z-10">
          <%= letter %>
        </div>

        <div class="artists-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 px-4 py-2">
          <% artists.each do |artist| %>
            <% songs = @artist_songs[artist.id] || [] %>
            <div class="artist-card group">
              <div class="artist-name flex items-center mb-2">
                <%# An ActiveStorage attachment proxy is truthy even when nothing
                    is attached, so `cover_art || artist.image` never reached the
                    fallback. Ask .attached? explicitly instead. %>
                <%- album_cover = artist.albums.first&.cover_art -%>
                <%- artwork = album_cover&.attached? ? album_cover : artist.image -%>
                <% if artwork&.attached? %>
                  <%= image_tag artwork,
                      class: "rounded-lg w-10 mr-2 h-auto border-2 border-gray-200",
                      alt: artist.name %>
                <% end %>
                <span class="font-medium text-lg truncate"><%= artist.name %></span>
              </div>

              <% if songs.any? %>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                  <% songs.each do |song| %>
                    <%= render partial: "zuke/components/smart-image", locals: { controller_name: "smart-image", song: song } %>
                  <% end %>
                </div>
              <% else %>
                <span class="text-sm text-gray-400">No tracks yet</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
