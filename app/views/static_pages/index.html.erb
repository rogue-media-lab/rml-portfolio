<%# RML Workbench Home — Digital Workbench Design %>
<% content_for(:title) { "Rogue Media Lab — Digital Workbench" } %>
<% content_for(:body_class) { "bg-zinc-950 text-zinc-50" } %>
<% content_for(:main_class) { "flex flex-col min-h-screen w-full" } %>

<div class="w-full min-h-screen bg-zinc-950 antialiased">

  <%= render 'shared/workbench_nav', active_page: 'workbench' %>

  <%# ─── HERO SECTION (turbo frame for Rocky swap) ─── %>
  <turbo-frame id="workbench-hero">
  <div class="flex justify-center w-full pt-10 md:pt-15 pb-4 md:pb-8 px-6 md:px-16">
    <div class="flex items-center rounded-full py-1.5 px-3 gap-2 border border-zinc-800">
      <div class="w-1.5 h-1.5 rounded-[3px] bg-orange-600"></div>
      <span class="text-center text-orange-600 font-mono text-xs">Bridging the gap between legacy stability and future tech.</span>
    </div>
  </div>

  <%# ─── ROCKY + PROJECTS (asymmetric: Rocky left, 2x2 projects right) ─── %>
  <div class="flex flex-col lg:flex-row justify-center w-full pt-2 md:pt-4 pb-16 md:pb-20 gap-4 lg:gap-6 px-6 md:px-16">

    <%# Left — Rocky (prominent) %>
    <div class="lg:w-[48%] lg:max-w-[640px] flex">
      <div class="w-full rounded-2xl overflow-hidden bg-[#050505] border border-zinc-800 shadow-[0_10px_40px_rgba(0,0,0,0.5)] flex flex-col md:flex-row md:h-72">
        <%# Left — Rocky Visualizer %>
        <div class="w-full md:w-72 h-44 md:h-full relative flex items-center justify-center shrink-0 overflow-hidden bg-zinc-950 border-b md:border-b-0 md:border-r border-zinc-800">
          <div class="absolute w-64 h-64 rounded-full" style="background-image: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(83.7% 0.016 0.164 / 10%) 0%, oklab(0% 0 .0001 / 0%) 70%)"></div>
          <div class="w-16 h-16 rounded-lg relative bg-[#050505] border-2 border-yellow-400 shadow-[0_0_24px_rgba(251,191,36,0.4)] shrink-0" style="transform: rotate(45deg)"></div>
          <div class="absolute flex items-center justify-center gap-[3px] w-full h-full">
            <div class="w-[3px] h-8 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-16 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-6 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-14 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-10 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-5 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
            <div class="w-[3px] h-12 rounded-[1px] bg-teal-400 shadow-[0_0_8px_rgba(45,212,191,0.8)] shrink-0"></div>
          </div>
        </div>
        <%# Right — Rocky Interface %>
        <div class="flex-1 flex flex-col justify-between relative p-5 md:p-7 gap-4 md:gap-0">
          <div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(83.7% 0.016 0.164 / 3%) 0%, oklab(0% 0 .0001 / 0%) 50%)"></div>
          <div class="flex flex-col sm:flex-row justify-between items-start relative gap-3 sm:gap-0">
            <div class="flex flex-col gap-1">
              <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-lg">Rocky // Lab Assistant</span>
              <div class="flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-[3px] bg-green-400"></div>
                <span class="text-zinc-500 font-mono text-[11px]"><span class="hidden sm:inline">STATUS: </span>ONLINE <span class="hidden sm:inline">// LISTENING_FOR_INPUT</span></span>
              </div>
            </div>
            <%= link_to rocky_chat_path, class: "rounded-md py-2.5 px-5 bg-zinc-50 hover:bg-zinc-200 transition-colors cursor-pointer text-center sm:w-auto w-full", data: { turbo_frame: "workbench-hero" } do %>
              <span class="uppercase text-zinc-950 font-['Inter',system-ui,sans-serif] font-bold text-[13px]">Initiate</span>
            <% end %>
          </div>
          <p class="relative text-zinc-400 font-['Inter',system-ui,sans-serif] italic text-sm">"*harmonic hum* Good morning, friend. How can the Lab help today?"</p>
        </div>
      </div>
    </div>

    <%# Right — 2x2 project grid (compact) %>
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-4">

      <%# Zuke %>
      <div class="flex flex-col relative rounded-xl overflow-hidden gap-2 bg-zinc-900 border border-zinc-800 p-4">
        <div class="absolute top-0 left-0 w-full h-1 bg-blue-500"></div>
        <div class="flex justify-between items-center relative">
          <span class="tracking-[0.05em] uppercase text-blue-500 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-base">Zuke</span>
          <span class="text-zinc-600 font-mono text-[10px]">/MUSIC</span>
        </div>
        <h3 class="text-base leading-[1.2] text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">Music Player</h3>
        <p class="text-xs leading-[1.5] text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">Personal music library — songs, albums, playlists, EQ.</p>
        <div class="mt-auto flex items-center pt-2 gap-2 relative">
          <%= link_to music_list_zuke_index_path, class: "flex items-center gap-2", data: { turbo: false } do %>
            <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">Open</span>
            <span class="text-blue-500 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">&rarr;</span>
          <% end %>
        </div>
      </div>

      <%# Carus %>
      <div class="flex flex-col relative rounded-xl overflow-hidden gap-2 bg-zinc-900 border border-zinc-800 p-4">
        <div class="absolute top-0 left-0 w-full h-1 bg-green-500"></div>
        <div class="flex justify-between items-center relative">
          <span class="tracking-[0.05em] uppercase text-green-500 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-base">Carus</span>
          <span class="text-zinc-600 font-mono text-[10px]">/VEHICLES</span>
        </div>
        <h3 class="text-base leading-[1.2] text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">Vehicle Relationships</h3>
        <p class="text-xs leading-[1.5] text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">Two-sided platform connecting car owners with shops.</p>
        <div class="mt-auto flex items-center pt-2 gap-2 relative">
          <%= link_to carus_root_path, class: "flex items-center gap-2", data: { turbo: false } do %>
            <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">Open</span>
            <span class="text-green-500 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">&rarr;</span>
          <% end %>
        </div>
      </div>

      <%# Hermit Plus %>
      <div class="flex flex-col relative rounded-xl overflow-hidden gap-2 bg-zinc-900 border border-zinc-800 p-4">
        <div class="absolute top-0 left-0 w-full h-1 bg-yellow-400"></div>
        <div class="flex justify-between items-center relative">
          <span class="tracking-[0.05em] uppercase text-yellow-400 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-base">Hermit Plus</span>
          <span class="text-zinc-600 font-mono text-[10px]">/CREW</span>
        </div>
        <h3 class="text-base leading-[1.2] text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">Minecraft Crew Hub</h3>
        <p class="text-xs leading-[1.5] text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">Hermitcraft roster, seasons, and crew favorites.</p>
        <div class="mt-auto flex items-center pt-2 gap-2 relative">
          <%= link_to hermits_path, class: "flex items-center gap-2", data: { turbo: false } do %>
            <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">Open</span>
            <span class="text-yellow-400 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">&rarr;</span>
          <% end %>
        </div>
      </div>

      <%# Waypoint (placeholder — private repo, not yet in portfolio) %>
      <div class="flex flex-col relative rounded-xl overflow-hidden gap-2 bg-zinc-900/50 border border-dashed border-zinc-700 p-4 opacity-70">
        <div class="absolute top-0 left-0 w-full h-1 bg-red-500"></div>
        <div class="flex justify-between items-center relative">
          <span class="tracking-[0.05em] uppercase text-red-500 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-base">Waypoint</span>
          <span class="text-zinc-600 font-mono text-[10px]">/SOON</span>
        </div>
        <h3 class="text-base leading-[1.2] text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">Shop Floor Tracker</h3>
        <p class="text-xs leading-[1.5] text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">Service jobs and hours, tied to vehicles and technicians.</p>
        <div class="mt-auto flex items-center pt-2 gap-2 relative">
          <span class="text-zinc-600 font-['Inter',system-ui,sans-serif] font-semibold text-[11px]">Coming soon</span>
        </div>
      </div>

    </div>
  </div>
  </turbo-frame>

  <%# ─── THE PILLARS ─── %>
  <div class="flex flex-col md:flex-row justify-center w-full pt-10 md:pt-15 pb-20 md:pb-30 gap-6 md:gap-8 px-6 md:px-16">

    <%# The Lab Card %>
    <div class="flex-1 max-w-100 flex flex-col relative rounded-xl overflow-hidden gap-6 bg-zinc-900 border border-zinc-800 p-6 md:p-10">
      <div class="absolute top-0 left-0 w-full h-1 bg-orange-600"></div>
      <div class="flex justify-between items-center relative">
        <span class="tracking-[0.05em] uppercase text-orange-600 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-xl">The Lab</span>
        <span class="text-zinc-600 font-mono text-[11px]">/HIRE</span>
      </div>
      <h3 class="text-[28px] leading-[1.2] relative text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">The Lab can build it!</h3>
      <p class="text-[16px] leading-[1.5] relative text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">Unleash the power of Rails and AI, a match made in heaven. Custom apps and software does not have to be expensive or complicated.</p>
      <div class="mt-auto flex items-center pt-8 gap-2 relative">
        <%= link_to lab_path, class: "flex items-center gap-2" do %>
          <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-sm">Enter The Lab</span>
          <span class="text-orange-600 font-['Inter',system-ui,sans-serif] font-semibold text-sm">&rarr;</span>
        <% end %>
      </div>
      <div class="w-full h-25 mt-4 flex items-center justify-center relative rounded-lg overflow-hidden bg-zinc-950 border border-zinc-800 shrink-0">
        <div class="absolute w-[150px] h-[150px] rounded-full" style="background-image: radial-gradient(circle farthest-corner at 50% 50% in oklab, oklab(83.7% 0.016 0.164 / 8%) 0%, oklab(0% 0 .0001 / 0%) 70%)"></div>
        <div class="absolute w-full flex items-center justify-center opacity-50 gap-[2px]">
          <div class="w-0.5 h-2.5 rounded-[1px] bg-teal-400 shrink-0"></div>
          <div class="w-0.5 h-5 rounded-[1px] bg-teal-400 shrink-0"></div>
          <div class="w-0.5 h-[15px] rounded-[1px] bg-teal-400 shrink-0"></div>
          <div class="w-0.5 h-[25px] rounded-[1px] bg-teal-400 shrink-0"></div>
          <div class="w-0.5 h-3 rounded-[1px] bg-teal-400 shrink-0"></div>
        </div>
        <div class="flex items-center justify-center rounded-sm relative border-2 border-yellow-400 shrink-0 w-6 h-6" style="transform: rotate(45deg)">
          <div class="border border-yellow-400/40 shrink-0 w-2.5 h-2.5"></div>
        </div>
      </div>
    </div>

    <%# Erudition Card %>
    <div class="flex-1 max-w-100 flex flex-col relative rounded-xl overflow-hidden gap-6 bg-zinc-900 border border-zinc-800 p-6 md:p-10">
      <div class="absolute top-0 left-0 w-full h-1 bg-purple-500"></div>
      <div class="flex justify-between items-center relative">
        <span class="tracking-[0.05em] uppercase text-purple-500 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-xl">Erudition</span>
        <span class="text-zinc-600 font-mono text-[11px]">/ACADEMY</span>
      </div>
      <h3 class="text-[28px] leading-[1.2] relative text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold m-0">Knowledge &amp; Education</h3>
      <p class="text-[16px] leading-[1.5] relative text-zinc-400 font-['Inter',system-ui,sans-serif] m-0">A modern publication focused on "Rails + AI" as a distinct discipline. Learn how to architect, prompt, and deploy AI natively in Ruby environments.</p>
      <div class="mt-auto flex items-center pt-8 gap-2 relative">
        <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-sm">Read Erudition</span>
        <span class="text-purple-500 font-['Inter',system-ui,sans-serif] font-semibold text-sm">&rarr;</span>
      </div>
      <div class="w-full h-25 mt-4 flex flex-col justify-center rounded-lg overflow-hidden gap-2 relative bg-zinc-950 border border-zinc-800 shrink-0 p-4">
        <div class="w-10 h-1 rounded-xs bg-purple-500 shrink-0"></div>
        <div class="w-full h-1.5 rounded-[3px] bg-zinc-800 shrink-0"></div>
        <div class="w-4/5 h-1.5 rounded-[3px] bg-zinc-800 shrink-0"></div>
        <div class="w-[90%] h-1.5 rounded-[3px] bg-zinc-800 shrink-0"></div>
      </div>
    </div>
  </div>

  <%# ─── ERUDITION PREVIEW SECTION ─── %>
  <div class="flex flex-col w-full pt-10 pb-20 gap-10 bg-[#050505] border-t border-zinc-800 px-6 md:px-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between w-full gap-4 md:gap-0">
      <div class="flex flex-col gap-2">
        <span class="text-purple-500 font-mono text-xs">LATEST INTEL</span>
        <h2 class="tracking-[0.02em] uppercase text-zinc-50 font-['Barlow_Condensed',system-ui,sans-serif] font-bold text-4xl m-0">From Erudition</h2>
      </div>
      <div class="pb-0.5 border-b border-zinc-400">
        <%= link_to "View all articles", blogs_path, class: "text-zinc-400 font-['Inter',system-ui,sans-serif] font-semibold text-sm hover:text-zinc-200 transition-colors cursor-pointer" %>
      </div>
    </div>

    <div class="flex flex-col rounded-lg overflow-hidden gap-px bg-zinc-800 border border-zinc-800">
      <% if @latest_articles.present? %>
        <% @latest_articles.each do |article| %>
          <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 bg-zinc-900 p-4 md:p-6">
            <span class="md:w-25 shrink-0 text-zinc-500 font-mono text-[13px]"><%= article.published_at.strftime("%Y.%m.%d") %></span>
            <div class="flex-1 flex flex-col gap-1">
              <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-base md:text-lg"><%= article.title %></span>
              <span class="text-zinc-400 font-['Inter',system-ui,sans-serif] text-[14px] md:text-[15px]"><%= article.subtitle %></span>
            </div>
            <span class="shrink-0 rounded-full py-1.5 px-3 border border-zinc-800 self-start md:self-auto">
              <span class="text-purple-500 font-mono text-[11px]"><%= article.blog_category&.title&.upcase || "ARTICLE" %></span>
            </span>
          </div>
        <% end %>
      <% else %>
        <%# Fallback static articles when no blogs exist yet %>
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 bg-zinc-900 p-4 md:p-6">
          <span class="md:w-25 shrink-0 text-zinc-500 font-mono text-[13px]">2026.04.12</span>
          <div class="flex-1 flex flex-col gap-1">
            <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-base md:text-lg">The Architecture of Rocky: Tool Calling in Rails</span>
            <span class="text-zinc-400 font-['Inter',system-ui,sans-serif] text-[14px] md:text-[15px]">Deep dive into how we built the Lab's resident AI assistant without touching React.</span>
          </div>
          <span class="shrink-0 rounded-full py-1.5 px-3 border border-zinc-800 self-start md:self-auto">
            <span class="text-purple-500 font-mono text-[11px]">AI ENGINEERING</span>
          </span>
        </div>
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 bg-zinc-900 p-4 md:p-6">
          <span class="md:w-25 shrink-0 text-zinc-500 font-mono text-[13px]">2026.03.28</span>
          <div class="flex-1 flex flex-col gap-1">
            <span class="text-zinc-50 font-['Inter',system-ui,sans-serif] font-semibold text-lg">Waveforms at Scale: Zuke's Audio Architecture</span>
            <span class="text-zinc-400 font-['Inter',system-ui,sans-serif] text-[15px]">Using audiowaveform and background jobs for robust media processing.</span>
          </div>
          <span class="shrink-0 rounded-full py-1.5 px-3 border border-zinc-800 self-start md:self-auto">
            <span class="text-blue-500 font-mono text-[11px]">SYSTEMS</span>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%= render 'shared/workbench_footer', section_name: 'Workbench' %>

</div>
