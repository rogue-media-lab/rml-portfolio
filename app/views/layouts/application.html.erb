<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rogue Media Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Zuke">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= display_meta_tags(default_meta_tags) %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon-192x192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-192x192.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/icon-192x192.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/icon-144x144.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/icon-144x144.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/icon-144x144.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/icon-72x72.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/icon-72x72.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=IM+Fell+English+SC&family=Inconsolata:wght@200..900&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=M+PLUS+Code+Latin:wght@100..700&family=Teko:wght@300..700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <%# Includes all stylesheet files in app/assets/stylesheets %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%#= render "shared/dark_mode_check" %>

    <%#
      Mobile debugging console (Eruda).
      On by default everywhere, production included, so the icon is on the phone.
      ?debug=false turns it off and ?debug=true turns it back on; either sticks in
      localStorage, because the installed PWA starts from the manifest URL and carries
      no query string — a URL-only switch would be unreachable from the app icon.
    %>
    <% eruda_on = true %>
    <% eruda_enable = params[:debug] == "true" %>
    <% eruda_disable = params[:debug] == "false" %>
    <script>
      (function () {
        // Booleans only. The param is never echoed into this script: escaping would turn
        // a quote into an entity the browser does not decode here, and a raw value could
        // end this tag early. Emitting true or false makes both impossible.
        // (And never write a closing script tag inside a script, even in a comment.)
        if (<%= eruda_enable.to_json %>) localStorage.setItem("eruda", "1");
        if (<%= eruda_disable.to_json %>) localStorage.setItem("eruda", "0");

        var flag = localStorage.getItem("eruda");
        var on = (<%= eruda_on.to_json %> && flag !== "0") || flag === "1";
        if (!on) return;

        var script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/eruda";
        script.onload = function () { eruda.init(); };
        document.head.appendChild(script);
      })();
    </script>

    <script>
      // Check localStorage or system preference immediately
      if (localStorage.getItem('color-theme') === 'dark' || 
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="<%= content_for?(:body_class) ? yield(:body_class) : 'bg-base-light text-base-dark dark:bg-base-dark dark:text-white' %>">
    <main class="<%= content_for?(:main_class) ? yield(:main_class) : 'flex flex-col justify-center items-center min-h-screen' %>">
      <%= render "shared/flash_notice" %>
      <% if controller_name == "blogs" %>
        <%= render "shared/blog_nav" %>
      <% elsif controller_name == "copywriter" %>
        <%= render "shared/copywriter_nav" %>
      <% elsif controller_name == "eastbounds" %>
        <%= render "shared/eastbound_nav" %>
      <% elsif controller_name == "hermit_plus" %>
        <%= render "shared/hermits_nav" %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
